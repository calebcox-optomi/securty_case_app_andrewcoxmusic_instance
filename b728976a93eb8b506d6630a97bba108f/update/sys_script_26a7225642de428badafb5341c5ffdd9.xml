    <script><![CDATA[// BR4: Only Managers May Close
(function () {
    if (current.getValue('state') == '7' && previous.getValue('state') != '7') {
        if (!gs.hasRole('x_2241073_securi_0.manager') && !gs.hasRole('admin')) {
            gs.addErrorMessage('Only security managers may set the state to Closed.');
            current.setValue('state', previous.getValue('state'));
        }
    }
})();
