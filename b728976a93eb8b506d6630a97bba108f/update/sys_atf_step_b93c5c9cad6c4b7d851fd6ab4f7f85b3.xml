    var caseId = steps('{{step['a986ceb46d2145be90c5969bf1045dfd'].record_id}}');
    var slaGR = new GlideRecord('task_sla');
    slaGR.addQuery('task', caseId);
    slaGR.query();
    var count = slaGR.getRowCount();
    assertEqual({
        name: 'At least one SLA record attached',
        shouldbe: 'true',
        value: String(count &gt; 0)
    });
    stepResult.setOutputMessage('Found ' + count + ' task_sla record(s) for the case');
})(outputs, steps, params, stepResult, assertEqual);</value>
