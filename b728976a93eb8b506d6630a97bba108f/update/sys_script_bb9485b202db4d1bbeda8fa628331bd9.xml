        <script><![CDATA[// BR1: Set Active Flag
// States 6=Resolved, 7=Closed, 8=Cancelled → active=false
(function () {
    var state = current.getValue('state');
    if (state == '6' || state == '7' || state == '8') {
        current.setValue('active', false);
    } else {
        current.setValue('active', true);
    }
})();
]]></script>
